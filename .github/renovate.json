{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "dependencyDashboard": true,
  "tekton": {
    "enabled": true,
    "automergeType": "pr",
    "automerge": true,
    "platformAutomerge": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "groupName": "All Python Dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Automerge digest updates for Red Hat published images",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "matchPackageNames": [
        "/^registry\\.access\\.redhat\\.com\\//",
        "/^registry\\.redhat\\.io\\//"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG RENOVATE_REVISION=(?<currentDigest>.*?)\\n"
      ],
      "currentValueTemplate": "renovate-44-209-0",
      "depNameTemplate": "redhat-exd-rebuilds/renovate",
      "packageNameTemplate": "https://github.com/redhat-exd-rebuilds/renovate",
      "datasourceTemplate": "git-refs"
    },
    {
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "customType": "regex",
      "description": "Update dependency versions in the Dockerfile",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s(?:ENV|ARG) .+?_VERSION=(?<currentValue>.+?)\\s"
      ]
    },
    {
      "managerFilePatterns": [
        "/^\\.github/workflows\\/.*\\.ya?ml$/"
      ],
      "customType": "regex",
      "description": "Update tool versions in GitHub Actions workflows",
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s+ACTIONLINT_VERSION: (?<currentValue>\\S+)"
      ]
    }
  ]
}
